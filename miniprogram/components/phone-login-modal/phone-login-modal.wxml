<view class="login-modal-mask" wx:if="{{show}}" catchtouchmove="preventTouch">
  <view class="login-modal" catchtouchmove="preventTouch">
    <view class="login-modal-close" bindtap="onClose" catchtap="onClose">
      <text class="login-modal-close-icon">×</text>
    </view>
    <view class="login-modal-header">
      <text class="login-modal-title">欢迎登录美承影院</text>
      <text class="login-modal-desc">使用手机号验证码完成注册/登录</text>
    </view>
    <view class="login-modal-form">
      <view class="login-label">手机号</view>
      <view class="login-phone-row">
        <input
          class="login-input"
          type="number"
          maxlength="11"
          placeholder="请输入11位手机号"
          placeholder-class="login-placeholder"
          value="{{phone || ''}}"
          bindinput="onPhoneInput"
        />
      </view>
      <view class="login-label">验证码</view>
      <view class="login-otp-row">
        <input
          class="login-input login-otp-input"
          type="number"
          maxlength="6"
          placeholder="请输入验证码"
          placeholder-class="login-placeholder"
          value="{{code || ''}}"
          bindinput="onCodeInput"
        />
        <view
          class="login-send-btn {{sendingCode || countdown > 0 ? 'disabled' : ''}}"
          bindtap="onSendCode"
        >
          {{sendingCode ? '发送中...' : (countdown > 0 ? countdown + 's后重发' : '发送验证码')}}
        </view>
      </view>
      <view wx:if="{{otpSent}}" class="login-resend-row">
        <text class="login-resend-text">没有收到验证码？</text>
        <text wx:if="{{countdown <= 0 && !sendingCode}}" class="login-resend-link" bindtap="onSendCode">重新发送</text>
        <text wx:else class="login-resend-text">{{countdown}}秒后重试</text>
      </view>
      <view class="login-agree-row">
        <view class="login-checkbox {{agreedToTerms ? 'checked' : ''}}" bindtap="onAgreeChange">
          <text wx:if="{{agreedToTerms}}">✓</text>
        </view>
        <text class="login-agree-text" bindtap="onAgreeChange">登录即同意</text>
        <text class="login-agree-link" catchtap="onOpenServiceAgreement">《用户服务协议》</text>
        <text class="login-agree-text" bindtap="onAgreeChange">和</text>
        <text class="login-agree-link" catchtap="onOpenPrivacyAgreement">《隐私协议》</text>
      </view>
      <view
        class="login-submit-btn {{verifying ? 'disabled' : ''}}"
        bindtap="onVerify"
      >
        {{verifying ? '登录中...' : '登录'}}
      </view>
      <view wx:if="{{errorMessage}}" class="login-error">
        <text class="login-error-icon">!</text>
        <text class="login-error-text">{{errorMessage}}</text>
      </view>
    </view>
  </view>
</view>
