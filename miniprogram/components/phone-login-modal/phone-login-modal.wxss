/* 手机号+验证码登录弹窗组件 */
.login-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}
.login-modal {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  position: relative;
  max-height: 90vh;
  overflow-y: auto;
}
.login-modal-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}
.login-modal-close-icon {
  font-size: 48rpx;
  font-weight: 300;
  color: #999;
  line-height: 1;
}
.login-modal-header {
  margin-bottom: 40rpx;
  text-align: center;
}
.login-modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}
.login-modal-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}
.login-modal-form .login-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}
.login-modal-form .login-input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 30rpx;
  margin-bottom: 32rpx;
  color: #000;
}
.login-phone-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.login-phone-row .login-input {
  flex: 1;
  margin-bottom: 0;
}
.login-phone-btn {
  flex-shrink: 0;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  color: var(--primary);
  background: transparent;
  border: none;
}
.login-phone-btn::after {
  border: none;
}
.login-otp-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.login-otp-input {
  flex: 1;
  margin-bottom: 0;
  border-radius: 12rpx 0 0 12rpx;
}
.login-send-btn {
  width: 200rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  text-align: center;
  border-radius: 0 12rpx 12rpx 0;
}
.login-send-btn.disabled {
  background: #ccc;
  color: #999;
}
.login-placeholder {
  color: #999;
}
.login-resend-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  gap: 16rpx;
}
.login-resend-text {
  font-size: 26rpx;
  color: #999;
}
.login-resend-link {
  font-size: 26rpx;
  color: var(--primary);
}
.login-agree-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
  flex-wrap: wrap;
}
.login-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ccc;
  border-radius: 8rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}
.login-checkbox.checked {
  background: var(--primary);
  border-color: var(--primary);
}
.login-agree-text {
  font-size: 24rpx;
  color: #999;
}
.login-agree-link {
  font-size: 24rpx;
  color: var(--primary);
  text-decoration: underline;
}
.login-submit-btn {
  height: 88rpx;
  line-height: 88rpx;
  background: var(--primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border-radius: 12rpx;
}
.login-submit-btn.disabled {
  background: #ccc;
}
.login-error {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffebee;
  border-radius: 12rpx;
  border: 1rpx solid #ffcdd2;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.login-error-icon {
  font-size: 28rpx;
  color: #d32f2f;
}
.login-error-text {
  flex: 1;
  font-size: 26rpx;
  color: #d32f2f;
}
