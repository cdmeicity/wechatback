/* 登录页 */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FE4A49 0%, #fff 28%);
  display: flex;
  flex-direction: column;
  padding: 0 40rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.login-header {
  padding-top: 120rpx;
  padding-bottom: 80rpx;
}

.login-title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 24rpx;
}

.login-desc {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.5;
}

.login-body {
  flex: 1;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 60rpx 32rpx 40rpx;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.login-loading-text {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

.login-btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
}

.login-btn-primary::after {
  border: none;
}

.login-agree-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.login-checkbox {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  border: 2rpx solid #ccc;
  border-radius: 6rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-checkbox.checked {
  background: #07c160;
  border-color: #07c160;
  position: relative;
}

.login-checkbox-tick {
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  line-height: 36rpx;
}

.login-tip-inline {
  color: #999;
}

.login-link {
  color: #FE4A49;
  text-decoration: underline;
  margin: 0 4rpx;
}

.login-deny-tip {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #fff5f5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #c00;
  text-align: center;
}

.login-footer {
  padding: 32rpx 0;
  text-align: center;
}

.login-footer-text {
  font-size: 24rpx;
  color: #999;
}
