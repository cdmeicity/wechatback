<view class="movie-search-page light-theme">
  <!-- 搜索框：VI 白底 surface、浅灰边框 border、背景 background -->
  <view class="movie-search-bar-wrap">
    <view class="movie-search-bar">
      <image class="movie-search-icon" src="/images/icon-search.svg" mode="aspectFit" />
      <input
        class="movie-search-input"
        placeholder="搜索影片名称、类型或代码"
        placeholder-class="movie-search-placeholder"
        value="{{keyword}}"
        bindinput="onInput"
        bindconfirm="onInput"
      />
      <view
        wx:if="{{keyword}}"
        class="movie-search-clear"
        bindtap="onClear"
      >
        <text class="movie-search-clear-icon">×</text>
      </view>
    </view>
  </view>

  <!-- 列表：与首页热映同一数据源，竖向卡片 -->
  <scroll-view
    scroll-y
    class="movie-search-list"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view wx:if="{{loading}}" class="movie-search-loading">
      <view class="movie-search-spinner"></view>
      <text class="movie-search-loading-text">加载中...</text>
    </view>

    <view wx:elif="{{hotMovies.length === 0}}" class="movie-search-empty">
      <text class="movie-search-empty-icon">🎬</text>
      <text class="movie-search-empty-title">暂无热映影片</text>
      <text class="movie-search-empty-hint">请在首页选择影院后查看</text>
    </view>

    <view wx:elif="{{filteredMovies.length === 0}}" class="movie-search-empty">
      <text class="movie-search-empty-icon">🔍</text>
      <text class="movie-search-empty-title">未找到相关影片</text>
    </view>

    <view wx:else class="movie-search-cards">
      <view
        wx:for="{{filteredMovies}}"
        wx:key="id"
        class="movie-search-card"
        data-id="{{item.id}}"
        bindtap="goMovie"
      >
        <view class="movie-search-card-poster-wrap">
          <image
            wx:if="{{item.logo}}"
            class="movie-search-card-poster"
            src="{{item.logo}}"
            mode="aspectFill"
          />
          <view wx:else class="movie-search-card-poster-placeholder">
            <text class="movie-search-card-poster-icon">🎬</text>
            <text class="movie-search-card-poster-text">暂无海报</text>
          </view>
        </view>
        <view class="movie-search-card-info">
          <text class="movie-search-card-name">{{item.name}}</text>
          <view class="movie-search-card-meta">
            <view wx:if="{{item.type}}" class="movie-search-card-tag">{{item.type}}</view>
            <text wx:if="{{item.duration}}" class="movie-search-card-duration">{{item.duration}}分钟</text>
          </view>
          <view wx:if="{{item.rating != null}}" class="movie-search-card-rating">
            <text class="movie-search-card-star">★</text>
            <text class="movie-search-card-rating-num">{{item.rating}}</text>
          </view>
        </view>
        <text class="movie-search-card-arrow">›</text>
      </view>
    </view>
    <view class="movie-search-bottom-pad"></view>
  </scroll-view>
</view>
