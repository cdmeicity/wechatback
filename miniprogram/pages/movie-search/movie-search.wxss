/**
 * 影片搜索页 - VI 规范（与 Flutter MovieSearchPage 一致）
 */
@import '../../styles/vi.wxss';

page {
  background: var(--background);
  height: 100%;
}

.movie-search-page.light-theme {
  min-height: 100vh;
  background: var(--background);
  box-sizing: border-box;
}

/* 搜索框 */
.movie-search-bar-wrap {
  padding: var(--space-medium);
  background: var(--background);
}

.movie-search-bar {
  display: flex;
  align-items: center;
  height: var(--height-input);
  padding: 0 var(--space-medium);
  background: var(--surface);
  border-radius: var(--radius-medium);
  border: 2rpx solid var(--border);
  box-sizing: border-box;
}

.movie-search-icon {
  width: var(--icon-medium);
  height: var(--icon-medium);
  margin-right: var(--space-small);
  flex-shrink: 0;
}

.movie-search-input {
  flex: 1;
  height: 100%;
  font-size: var(--font-body1);
  color: var(--text-primary);
  min-width: 0;
}

.movie-search-placeholder {
  color: var(--text-placeholder);
}

.movie-search-clear {
  width: var(--icon-medium);
  height: var(--icon-medium);
  margin-left: var(--space-xsmall);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.movie-search-clear-icon {
  font-size: 40rpx;
  color: var(--text-secondary);
  line-height: 1;
}

/* 列表 */
.movie-search-list {
  height: calc(100vh - 120rpx);
  box-sizing: border-box;
}

.movie-search-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-xxlarge);
}

.movie-search-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: movie-search-spin 0.8s linear infinite;
}

@keyframes movie-search-spin {
  to { transform: rotate(360deg); }
}

.movie-search-loading-text {
  margin-top: var(--space-medium);
  font-size: var(--font-body1);
  color: var(--text-secondary);
}

.movie-search-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-xxlarge);
}

.movie-search-empty-icon {
  font-size: 96rpx;
  margin-bottom: var(--space-medium);
}

.movie-search-empty-title {
  font-size: var(--font-body1);
  color: var(--text-secondary);
  margin-bottom: var(--space-xsmall);
}

.movie-search-empty-hint {
  font-size: var(--font-caption);
  color: var(--text-placeholder);
}

/* 竖向影片卡片（VI：surface、border、radiusLarge，主色强调） */
.movie-search-cards {
  padding: 0 var(--space-medium) var(--space-large);
}

.movie-search-card {
  display: flex;
  align-items: flex-start;
  padding: var(--space-medium);
  margin-bottom: var(--space-medium);
  background: var(--surface);
  border-radius: var(--radius-large);
  border: 2rpx solid var(--border);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.movie-search-card-poster-wrap {
  width: 200rpx;
  height: 280rpx;
  border-radius: var(--radius-medium);
  border: 2rpx solid var(--border);
  overflow: hidden;
  flex-shrink: 0;
}

.movie-search-card-poster {
  width: 100%;
  height: 100%;
  display: block;
}

.movie-search-card-poster-placeholder {
  width: 100%;
  height: 100%;
  background: var(--border);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.movie-search-card-poster-icon {
  font-size: 64rpx;
  margin-bottom: var(--space-xsmall);
}

.movie-search-card-poster-text {
  font-size: var(--font-caption);
  color: var(--text-placeholder);
}

.movie-search-card-info {
  flex: 1;
  margin-left: var(--space-medium);
  min-width: 0;
}

.movie-search-card-name {
  font-size: var(--font-body1);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.movie-search-card-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-small);
  margin-top: var(--space-small);
}

.movie-search-card-tag {
  padding: 4rpx var(--space-small);
  background: rgba(254, 74, 73, 0.1);
  border-radius: var(--radius-small);
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--primary);
}

.movie-search-card-duration {
  font-size: var(--font-caption);
  color: var(--text-secondary);
}

.movie-search-card-rating {
  display: flex;
  align-items: center;
  margin-top: var(--space-small);
  gap: 8rpx;
}

.movie-search-card-star {
  font-size: 28rpx;
  color: var(--accent);
}

.movie-search-card-rating-num {
  font-size: var(--font-caption);
  color: var(--text-secondary);
}

.movie-search-card-arrow {
  font-size: var(--icon-medium);
  color: var(--text-secondary);
  margin-left: var(--space-xsmall);
  flex-shrink: 0;
}

.movie-search-bottom-pad {
  height: var(--space-large);
}
