/* 订单页面 - 参照 ticketinfo 风格，VI 规范 */

page {
  background: var(--background);
}

.order-page.light-theme {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--background);
  overflow-x: hidden;
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background: var(--surface);
  padding: 0 var(--space-large);
  border-bottom: 2rpx solid var(--border);
}

.tab-item {
  flex: 1;
  padding: var(--space-medium) 0;
  text-align: center;
  font-size: var(--font-body2);
  color: var(--text-secondary);
}

.tab-item.active {
  color: var(--primary);
  font-weight: 600;
  border-bottom: 4rpx solid var(--primary);
}

/* 订单列表 - 两侧 8px (16rpx) */
.order-list {
  height: calc(100vh - 100rpx);
  padding: var(--space-medium) var(--space-small);
  box-sizing: border-box;
  overflow-x: hidden;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: var(--space-xxlarge);
  color: var(--text-secondary);
  font-size: var(--font-body1);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-xxlarge);
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: var(--space-medium);
}

.empty-text {
  font-size: var(--font-body1);
  color: var(--text-secondary);
}

/* 订单卡片 */
.order-card {
  width: 100%;
  box-sizing: border-box;
  background: var(--surface);
  border-radius: var(--radius-medium);
  border: 2rpx solid var(--border);
  padding: var(--space-medium);
  margin-bottom: var(--space-medium);
}

.card-row {
  display: flex;
  align-items: flex-start;
  gap: var(--space-medium);
  min-width: 0;
  overflow: hidden;
}

.poster-wrap {
  flex-shrink: 0;
  width: 160rpx;
  height: 240rpx;
  border-radius: var(--radius-small);
  overflow: hidden;
  background: var(--border);
}

.poster {
  width: 100%;
  height: 100%;
  display: block;
}

.poster-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.card-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-small);
  margin-bottom: var(--space-xsmall);
  min-width: 0;
}

.movie-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-h5);
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.status-badge {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-small);
  font-size: var(--font-caption);
  font-weight: 600;
  color: #FFF;
}

.status-badge.status-paid {
  background: var(--primary);
}

.status-badge.status-pending {
  background: var(--warning);
}

.status-badge.status-watched {
  background: var(--success);
}

/* 全部订单内「已观看」灰色样式 */
.status-badge.status-watched-grey {
  background: #9e9e9e;
  color: #fff;
}

.meta, .cinema, .time {
  display: block;
  font-size: var(--font-caption);
  color: var(--text-secondary);
  margin-top: var(--space-xsmall);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seats {
  display: block;
  font-size: var(--font-caption);
  color: var(--text-secondary);
  margin-top: var(--space-xsmall);
  word-break: break-all;
  overflow-wrap: break-word;
}

.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-small);
  margin-top: var(--space-medium);
  padding-top: var(--space-medium);
  border-top: 2rpx solid var(--border);
  justify-content: flex-end;
  overflow: hidden;
}

.btn-outline {
  padding: 12rpx 24rpx;
  font-size: var(--font-body2);
  font-weight: 600;
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-medium);
}

.btn-primary-sm {
  padding: 12rpx 24rpx;
  font-size: var(--font-body2);
  font-weight: 600;
  color: #FFF;
  background: var(--primary);
  border-radius: var(--radius-medium);
}

.btn-success {
  padding: 12rpx 24rpx;
  font-size: var(--font-body2);
  font-weight: 600;
  color: #FFF;
  background: var(--success);
  border-radius: var(--radius-medium);
}
