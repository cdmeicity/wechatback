.screen {
  text-align: center;
  padding: var(--space-medium);
  color: var(--text-secondary);
  font-size: var(--font-caption);
}

.seat-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--space-small);
  padding: var(--space-xlarge) 0;
}

.seat {
  width: 60rpx;
  height: 60rpx;
  background: var(--surface-dark);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-small);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.seat.selected {
  background: var(--seat-selected);
  border-color: var(--seat-selected);
}

.seat.sold {
  background: var(--seat-sold);
  color: var(--text-secondary);
}

.legend {
  display: flex;
  justify-content: center;
  gap: var(--space-xlarge);
  padding: var(--space-large);
  font-size: var(--font-caption);
  color: var(--text-secondary);
}

.dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: var(--radius-small);
  display: inline-block;
  margin-right: 8rpx;
  vertical-align: middle;
}

.dot.available { background: var(--surface-dark); border: 2rpx solid var(--border); }
.dot.selected { background: var(--seat-selected); }
.dot.sold { background: var(--seat-sold); }

.btn {
  margin: var(--space-xlarge);
  height: var(--height-button);
  line-height: var(--height-button);
  background: var(--primary);
  color: var(--surface);
  border-radius: var(--radius-medium);
  font-size: var(--font-button);
  font-weight: 600;
}
