/**
 * Cinema 售票平台 - 字体系统 (VI 规范)
 * 基准：750 设计稿，1px ≈ 2rpx
 */
page {
  /* 字号 */
  --font-h1: 80rpx;
  --font-h2: 64rpx;
  --font-h3: 56rpx;
  --font-h4: 48rpx;
  --font-h5: 40rpx;
  --font-h6: 36rpx;
  --font-body1: 32rpx;
  --font-body2: 28rpx;
  --font-caption: 24rpx;
  --font-overline: 20rpx;
  --font-button: 28rpx;
  --font-label: 24rpx;
  --font-price: 40rpx;
  --font-movie-title: 44rpx;
  --font-cinema-name: 36rpx;
  /* 行高 */
  --line-h1: 1.2;
  --line-h2: 1.25;
  --line-h3: 1.3;
  --line-body: 1.5;
  --line-caption: 1.4;
  /* 字重 (需在 class 中应用) */
}

/* 标题类 */
.h1 { font-size: var(--font-h1); font-weight: 700; line-height: var(--line-h1); }
.h2 { font-size: var(--font-h2); font-weight: 700; line-height: var(--line-h2); }
.h3 { font-size: var(--font-h3); font-weight: 600; line-height: var(--line-h3); }
.h4 { font-size: var(--font-h4); font-weight: 600; line-height: var(--line-h3); }
.h5 { font-size: var(--font-h5); font-weight: 600; line-height: 1.4; }
.h6 { font-size: var(--font-h6); font-weight: 600; line-height: 1.4; }
.body1 { font-size: var(--font-body1); font-weight: 400; line-height: var(--line-body); }
.body2 { font-size: var(--font-body2); font-weight: 400; line-height: var(--line-body); }
.caption { font-size: var(--font-caption); font-weight: 400; line-height: var(--line-caption); }
.overline { font-size: var(--font-overline); font-weight: 500; line-height: 1.6; }
.button-text { font-size: var(--font-button); font-weight: 600; }
.label { font-size: var(--font-label); font-weight: 500; }
.price { font-size: var(--font-price); font-weight: 700; }
.movie-title { font-size: var(--font-movie-title); font-weight: 700; }
.cinema-name { font-size: var(--font-cinema-name); font-weight: 600; }
